ANTHROPIC_API_KEY=your-api-key-here
XWEATHER_CLIENT_ID=your-xweather-client-id
XWEATHER_CLIENT_SECRET=your-xweather-client-secret
OPENAI_API_KEY=your-openai-api-key-here
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=weatherwise-knowledge

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console  # "console" or "json"

# LangSmith tracing (optional)
# LANGCHAIN_API_KEY=your-langsmith-api-key
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=weatherwise

# Production checkpointer (for --checkpointer sqlite)
# CHECKPOINT_DB_PATH=weatherwise_checkpoints.db
